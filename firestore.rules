rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 👤 Profili utenti
    match /users/{userId} {
      // Lettura: serve per cercare amici, vedere nome/foto nelle richieste e nei post.
      // NOTA: espone anche gli altri campi del profilo (es. email) agli utenti loggati.
      // Soluzione futura: separare i dati pubblici (username, foto) in un documento a parte.
      allow read: if signedIn();

      // Il proprietario fa tutto sul proprio profilo
      allow create, update, delete: if signedIn() && request.auth.uid == userId;

      // Gli altri possono toccare SOLO i campi delle amicizie (richieste e amici)
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['pendingRequests', 'sentRequests', 'friends']);
    }

    // 💬 Chat tra amici
    match /chats/{chatId} {
      allow get: if signedIn()
        && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if signedIn()
        && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // 📸 Post community
    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && request.auth.uid == resource.data.uid;
      allow update: if signedIn() && (
        request.auth.uid == resource.data.uid
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['likes', 'likedBy'])
      );
    }

    // 🚨 Segnalazioni post (solo scrittura; le leggi dalla console)
    match /reports/{reportId} {
      allow create: if signedIn();
    }

    // 📝 Eventi segnalati dagli utenti (solo scrittura)
    match /eventi_segnalati/{id} {
      allow create: if signedIn();
    }

    // 📅 Eventi (lettura pubblica)
    match /events/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // 🔒 Tutto il resto bloccato
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
